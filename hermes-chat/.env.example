# Hermes Chat — free-tier keys (all optional; router auto-uses whatever is set)
# Cloud free tiers — get keys free, router auto-switches when a daily limit is hit.
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
TOGETHER_API_KEY=
HF_TOKEN=
# Local — fully free, no key. Run: ollama serve && ollama pull llama3.1
OLLAMA_BASE_URL=http://localhost:11434
# Custom OpenAI-compatible endpoint (also addable from UI → Connections → Add AI)
CUSTOM_API_BASE=
CUSTOM_API_KEY=
CUSTOM_MODELS=
# Daily request caps (tune to your free tiers). 0 = unlimited.
LIMIT_GROQ_PER_DAY=14000
LIMIT_GEMINI_PER_DAY=1500
LIMIT_OPENROUTER_FREE_PER_DAY=200
LIMIT_TOGETHER_PER_DAY=1000
LIMIT_HF_PER_DAY=1000
# Uploads: bytes per chunk (5MB). Files stream to disk — no size limit.
UPLOAD_CHUNK_BYTES=5242880
